# ===========================================
# OmniSync AI — Environment Configuration
# ===========================================

# WhatsApp Cloud API (Meta Business Platform)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_APP_SECRET=your_app_secret_for_webhook_verification
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token

# Database (PostgreSQL)
DATABASE_URL=postgresql://omnisync:password@localhost:5432/omnisync

# Redis (Bull queue + pub/sub + cache)
REDIS_URL=redis://localhost:6379

# LLM (OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key
LLM_EVAL_MODEL=gpt-4o
LLM_EVAL_TEMPERATURE=0.1
LLM_DIGEST_TEMPERATURE=0.6

# Whisper (Audio transcription)
WHISPER_MODEL=whisper-1

# Server
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# Authentication
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRY=24h

# Agent Identity
SYSTEM_SECRET=your-hmac-system-secret-min-32-chars

# Object Storage (S3-compatible — for media files)
S3_BUCKET=omnisync-media
S3_REGION=ap-south-1
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com

# Scheduler Defaults
SCHEDULER_DEFAULT_TIMEOUT_SECONDS=7200
SCHEDULER_MAX_RETRIES=3
SCHEDULER_BACKOFF_BASE_SECONDS=300

# Dashboard (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3000
